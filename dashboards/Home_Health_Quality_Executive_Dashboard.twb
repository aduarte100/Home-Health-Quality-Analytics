                <zone forceUpdate='true' h='6694' id='39' type-v2='text' w='44500' x='53143' y='66444'>
                  <formatted-text>
                    <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Top Performing States</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='10'>Alabama and Arkansas consistently demonstrate the strongest patient satisfaction and recommendation scores across the evaluated states.</run>
                  </formatted-text>
